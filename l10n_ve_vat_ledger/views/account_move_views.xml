<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="account_move_view_form_inherit_vat_ledger_imports" model="ir.ui.view">
        <field name="name">account.move.view.form.inherit.vat.ledger.imports</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ref']" position="after">
                <field
                    name="l10n_ve_vat_book_emission"
                    invisible="move_type not in ('out_invoice', 'out_refund')"
                    readonly="state == 'cancel'"
                />
                <field
                    name="l10n_ve_purchase_type"
                    invisible="move_type not in ('in_invoice', 'in_refund')"
                    required="move_type in ('in_invoice', 'in_refund')"
                    readonly="state == 'cancel'"
                />
                <field name="l10n_ve_show_vat_ledger_import_fields" invisible="1"/>
                <field
                    name="l10n_ve_importation_form_number"
                    readonly="state == 'cancel'"
                    required="l10n_ve_show_vat_ledger_import_fields"
                    invisible="move_type not in ('in_invoice', 'in_refund') or not l10n_ve_show_vat_ledger_import_fields"
                />
            </xpath>
        </field>
    </record>
</odoo>
