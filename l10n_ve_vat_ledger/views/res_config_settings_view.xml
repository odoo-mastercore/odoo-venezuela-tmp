<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_vat_ledger" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.vat.ledger</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="l10n_ve_base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <div id="venezuela_localization_section" position="attributes">
                <attribute name="invisible">0</attribute>
            </div>
            <xpath expr="//block[@id='venezuela_localization']" position="inside">
                <setting id="l10n_ve_sale_vat_book_format" string="Libro IVA de ventas" company_dependent="1">
                    <field name="l10n_ve_sale_vat_book_format"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
